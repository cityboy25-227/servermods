["The Graveyard - Mob Spawning Config"]

	["The Graveyard - Mob Spawning Config".ghoul]
		enabled = true
		#Range: 0 ~ 100
		weight = 25
		#Range: 1 ~ 100
		minGroupSizeGhoul = 2
		#Range: 1 ~ 100
		maxGroupSizeGhoul = 5
		canBurnInSunlight = true
		canBeWithered = true
		whitelist = ["minecraft:jungle", "minecraft:taiga", "minecraft:dark_forest", "minecraft:forest", "minecraft:old_growth_spruce_taiga", "minecraft:old_growth_pine_taiga", "minecraft:swamp", "minecraft:bamboo_jungle"]
		blacklist = ["minecraft:flower_forest", "minecraft:mushroom_fields"]
		modWhitelist = ["#minecraft", "#graveyard_biomes"]

	["The Graveyard - Mob Spawning Config".revenant]
		enabled = true
		#Range: 0 ~ 100
		weight = 25
		#Range: 1 ~ 100
		minGroupSizeRevenant = 5
		#Range: 1 ~ 100
		maxGroupSizeRevenant = 8
		canBurnInSunlight = true
		canBeWithered = true
		whitelist = ["minecraft:jagged_peaks", "minecraft:snowy_taiga", "minecraft:windswept_gravelly_hills", "minecraft:snowy_plains", "minecraft:snowy_slopes", "minecraft:frozen_peaks", "minecraft:ice_spikes"]
		blacklist = ["minecraft:flower_forest", "minecraft:mushroom_fields"]
		modWhitelist = ["#minecraft", "#graveyard_biomes"]

	["The Graveyard - Mob Spawning Config".reaper]
		enabled = false
		canBurnInSunlight = true
		canBeWithered = true

	["The Graveyard - Mob Spawning Config".nightmare]
		enabled = true
		#Range: 0 ~ 100
		weight = 10
		#Range: 1 ~ 100
		minGroupSizeNightmare = 1
		#Range: 1 ~ 100
		maxGroupSizeNightmare = 1
		canBurnInSunlight = false
		canBeWithered = false
		whitelist = ["#taiga", "#extreme_hills", "#jungle", "#mesa", "#plains", "#savanna", "#icy", "#beach", "#forest", "#desert", "#swamp", "#underground", "#mountain"]
		blacklist = ["minecraft:flower_forest", "minecraft:mushroom_fields"]
		modWhitelist = ["#minecraft", "#graveyard_biomes"]

	["The Graveyard - Mob Spawning Config".skeleton_creeper]
		enabled = true
