		whitelist = ["#taiga", "#extreme_hills", "#jungle", "#mesa", "#plains", "#savanna", "#icy", "#beach", "#forest", "#desert", "#swamp", "#underground", "#mountain"]
		blacklist = ["minecraft:flower_forest", "minecraft:mushroom_fields"]
